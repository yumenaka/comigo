package common

// MessageModal 使用原生模态框管理焦点，确认和所有关闭路径统一结算回调。
templ MessageModal() {
	<dialog id="modal-overlay" aria-labelledby="modal-message" class="panel-surface m-auto w-[calc(100%-2rem)] max-w-sm max-h-[calc(100dvh-2rem)] overflow-auto p-6 bg-base-100 text-base-content rounded-lg border border-base-300">
		<h1 id="modal-message" class="text-lg font-semibold w-full text-center"></h1>
		<form method="dialog" class="flex justify-center mt-4 gap-3">
			<button id="modal-confirm" value="confirm" class="panel-control flex-1 px-4 py-2 bg-red-400 hover:bg-red-500 font-semibold text-white rounded shadow-md"></button>
			<button id="modal-cancel" value="cancel" autofocus class="panel-control flex-1 px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white rounded shadow-md"></button>
		</form>
	</dialog>
	<script>
		// 原生 close 同时覆盖按钮和 Esc；先清空回调与返回值，再允许回调打开下一条提示。
		function showMessage(options) {
			const dialog = document.getElementById("modal-overlay");
			const confirmButton = document.getElementById("modal-confirm");
			const cancelButton = document.getElementById("modal-cancel");
			const onlyConfirm = options.buttons === "confirm";
			document.getElementById("modal-message").textContent =
				options.message || i18next.t("default_prompt_message");
			confirmButton.textContent =
				options.confirmText || i18next.t(onlyConfirm ? "confirm" : "ok");
			confirmButton.autofocus = onlyConfirm;
			cancelButton.hidden = onlyConfirm;
			cancelButton.autofocus = !onlyConfirm;
			cancelButton.textContent = i18next.t("cancel");
			dialog.returnValue = "";
			dialog.onclose = () => {
				const callback =
					dialog.returnValue === "confirm"
						? options.onConfirm
						: options.onCancel;
				dialog.returnValue = "";
				dialog.onclose = null;
				if (typeof callback === "function") callback();
			};
			dialog.showModal();
		}
	</script>
}
